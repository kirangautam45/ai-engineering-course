# Get a key at https://console.anthropic.com/ — never commit your real .env file
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model the lessons use (defaults to claude-opus-5)
# MODEL=claude-opus-5

# Week 3 onward: your MongoDB connection string (MongoDB Atlas free tier works).
# Week 5 vector search needs Atlas, or the atlas-local Docker image:
# MONGODB_URI=mongodb://localhost:27017/ai-course?directConnection=true
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ai-course

# Day 20: a TEST account on your local Helpdesk API from the MERN course
# HELPDESK_URL=http://localhost:5002
# HELPDESK_EMAIL=test-student@example.com
# HELPDESK_PASSWORD=choose-a-test-password
