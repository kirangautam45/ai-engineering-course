# Get a key at https://console.anthropic.com/ — never commit your real .env file
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model the lessons use (defaults to claude-opus-5)
# MODEL=claude-opus-5

# Week 3 onward: your MongoDB connection string (MongoDB Atlas free tier works).
# Week 5 vector search needs Atlas, or the atlas-local Docker image:
# MONGODB_URI=mongodb://localhost:27017/ai-course?directConnection=true
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ai-course

# Day 20: a TEST account on your local Helpdesk API from the MERN course
# HELPDESK_URL=http://localhost:5002
# HELPDESK_EMAIL=test-student@example.com
# HELPDESK_PASSWORD=choose-a-test-password

# ---- Other providers (optional): used by ailib/llm.py and `python run.py providers` ----
# Which provider ailib/llm.py uses by default: anthropic, openai, deepseek, qwen or ollama
# LLM_PROVIDER=anthropic
# VISION_PROVIDER=qwen
# TRANSCRIPTION_PROVIDER=qwen

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-sol

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash

# Qwen (Alibaba Cloud Model Studio). Copy the API host shown when you create the key.
# DASHSCOPE_API_KEY=sk-...
# QWEN_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_VISION_MODEL=qwen3.8-omni-flash
# QWEN_ASR_MODEL=qwen3.8-omni-flash

# Local models with Ollama (free, no key): https://ollama.com
# OLLAMA_MODEL=qwen3:4b

# ---- Week 9: DocuChat Pro / deployment ----
# Embeddings: local (free, ~1 GB memory), openai or qwen (for small servers). Re-run ingestion after switching.
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIMENSIONS=512
# Required in production: protects uploads and deletes
# ADMIN_TOKEN=choose-a-long-random-string
# RERANK=off
